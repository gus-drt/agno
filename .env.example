# ==========================================
# Agno - Variáveis de Ambiente (Configuração)
# ==========================================

# Token do seu Bot no Telegram (obtenha via @BotFather)
TELEGRAM_BOT_TOKEN="seu_token_telegram_aqui"

# Seu ID de Usuário no Telegram para segurança (obtenha via @userinfobot)
# Se preenchido, apenas você poderá interagir com o bot
ALLOWED_USER_ID="seu_user_id_aqui"

# Configuração da API do Gemini (necessário se for usar o modo SDK)
GEMINI_API_KEY="sua_chave_gemini_aqui"
GCP_PROJECT_ID=""
GCP_LOCATION="us-central1"

# Comando do CLI instalado na máquina (padrão: "agy" ou "gemini")
CLI_COMMAND="agy"
